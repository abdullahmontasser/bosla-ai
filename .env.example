# Database connection for local PostgreSQL (Docker Compose)
DATABASE_URL="postgresql://careercraft:careercraft_dev_password@localhost:5432/careercraft_db?schema=public"

# Auth.js secret. Generate a fresh random value for every deployment.
AUTH_SECRET="dev-secret-replace-in-production-must-be-random"
NEXTAUTH_SECRET="dev-secret-replace-in-production"
# Leave NEXTAUTH_URL unset so Auth.js derives the host you opened. Set it only
# when the app runs behind a proxy that does not forward the host header.
# NEXTAUTH_URL="http://localhost:3000"

# Optional single sign on. A provider button only appears when both values for
# that provider exist, so leave a pair empty to hide it.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_LINKEDIN_ID=""
# AUTH_LINKEDIN_SECRET=""

# 32-byte hex key for AES-256-GCM symmetric encryption
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Transactional email for password reset and email verification (Resend)
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Bosla AI <noreply@careercraft.ai>"

